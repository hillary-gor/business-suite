# ---------------------------------------------------------------------------
# SkyJet Business Suite - environment template
# Copy to .env.local and fill in. NEVER commit real values.
#
# The hosted project is:
#   ref    isibttscwburdguydntg
#   region eu-west-1 (Ireland), Postgres 17.6.1
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase project - used by the browser for RLS-scoped READS ONLY.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://isibttscwburdguydntg.supabase.co

# Prefer the modern publishable key (sb_publishable_...) over the legacy anon
# JWT. It rotates independently of the JWT signing secret, so a key compromise
# does not force a signing-secret rotation that invalidates every live session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Lets an owner invite people from Settings → Manage users.
# Copy the service role key (or sb_secret_...) from Supabase → Project
# Settings → API. This is a Secret on Vercel, never NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # legacy JWT name, also accepted

# Optional public origin used in invite links. Defaults to the incoming Host.
# On Vercel production this must be the deployed https origin, not localhost,
# or invited people receive a link they cannot open.
# NEXT_PUBLIC_SITE_URL=https://skyjet-business-suite.vercel.app

# ---------------------------------------------------------------------------
# Transactional email (Resend)
#
# Invites and password links are sent by the application, not by Supabase's
# mailer. Use a dedicated From address on the verified domain for access mail.
# Keep info@ (or accounts@) for later customer documents — mixing password
# links with general correspondence trains people to treat info@ as a login
# channel, which is how phishing works.
#
# MAIL_FROM_ADDRESS must be on a domain verified in Resend.
# MAIL_REPLY_TO is optional; set it if humans should receive replies.
# MAIL_FEEDBACK_TO is optional extra inboxes for Give feedback (comma-separated).
# khilary4600@gmail.com and surgeinnovationsltd@gmail.com always receive it.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
MAIL_FROM_ADDRESS=invite@skyjetaircraftspares.com
MAIL_FROM_NAME=SkyJet Aircraft Spares
# MAIL_REPLY_TO=info@skyjetaircraftspares.com
# MAIL_FEEDBACK_TO=dev@example.com

# ---------------------------------------------------------------------------
# Database connections
#
# Read this section before changing a connection string. The three formats
# below are not interchangeable, and the reasons are not guessable.
#
# DNS: the direct host `db.<ref>.supabase.co` resolves to an IPv6 address
# ONLY. Dedicated IPv4 is a paid add-on. Vercel functions and most GitHub
# Actions runners are IPv4-only and therefore cannot reach the direct host at
# all. Anything running there must use a pooler host.
#
# The pooler host is per-tenant and must not be guessed. This project is on
# `aws-1-eu-west-1.pooler.supabase.com`. `aws-0-eu-west-1...` also resolves in
# DNS but belongs to other tenants; it will fail to authenticate.
#
# Pooler usernames are `<role>.<project-ref>`, not just `<role>`. The pooler
# needs the ref to route the connection, because one hostname serves many
# projects.
# ---------------------------------------------------------------------------

# 1. POOLED, TRANSACTION MODE, port 6543 - what the application uses.
#
# This MUST connect as the restricted `skyjet_app` role, not as `postgres` and
# not with the service-role key. `skyjet_app` has no INSERT/UPDATE/DELETE
# privilege on any ledger table; it may only EXECUTE the posting functions.
# See supabase/migrations/0005_posting_engine.sql.
#
# CONSTRAINT: transaction mode does NOT support named prepared statements. A
# client gets a different backend on each transaction, so a statement prepared
# on one is missing on the next. Never pass a `name` to a node-postgres query;
# server/db/pool.ts throws if you do. Session-level SET is equally unsafe -
# use `SET LOCAL` / `set_config(..., true)` inside the transaction.
#
# Vercel: this is a Secret, not Config. Paste the fully expanded URL — Vercel
# does not expand ${SKYJET_APP_PASSWORD}. The login role is skyjet_app_login
# (skyjet_app itself cannot log in). After saving, redeploy.
DATABASE_URL=postgresql://skyjet_app_login.isibttscwburdguydntg:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# 2. DIRECT, port 5432 (IPv6-only) - migrations and schema work from an
#    IPv6-capable host. Full protocol support, no pooler in the path.
SUPABASE_DB_URL=postgresql://postgres:[DB-PASSWORD]@db.isibttscwburdguydntg.supabase.co:5432/postgres

# 3. POOLED, SESSION MODE, port 5432 - the IPv4-reachable fallback for the
#    jobs that need full protocol support: migrations, the SQL invariant
#    runner and pgTAP from a CI runner that has no IPv6. Session mode keeps
#    one backend for the life of the connection, so prepared statements and
#    session SET both work, but connections are scarce - do not use it for
#    the application.
# SUPABASE_DB_URL=postgresql://postgres.isibttscwburdguydntg:[DB-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Local development (supabase start) uses neither pooler:
# DATABASE_URL=postgresql://skyjet_app:skyjet_app_local_password@127.0.0.1:54322/postgres
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Password assigned to the skyjet_app role when migrations run.
# In production this is set out-of-band and rotated; the migration only sets
# it when SKYJET_APP_PASSWORD is provided to `supabase db reset`.
SKYJET_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Connection pool sizing
#
# Keep max SMALL. The pooler is doing the real pooling; this pool exists only
# to avoid a TLS handshake per request. Every connection an instance holds
# occupies one of the pooler's client slots, and a serverless deployment may
# have hundreds of instances. 1-2 is right for Vercel; a long-lived container
# can go higher, but never above (pooler client limit / expected instances).
# ---------------------------------------------------------------------------
DATABASE_POOL_MAX=2
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=10000

# Safety net rather than a tuning knob: a report over a careless date range
# must not hold a connection open indefinitely and starve the posting path.
# Applied with SET LOCAL per transaction, because node-postgres would
# otherwise send it in the startup packet, which the pooler rejects.
DATABASE_STATEMENT_TIMEOUT_MS=30000

# TLS. Defaults to `require` (encrypted, certificate verified) for any remote
# host and off for localhost, so this normally needs no setting.
#   require    - encrypt and verify. Hosted Supabase uses a private CA, which
#                the pool loads automatically from certs/supabase-prod-ca-2021.crt.
#   no-verify  - encrypt but DO NOT verify. Emits a warning on every start.
#                A last resort; prefer DATABASE_SSL_CA.
#   disable    - plaintext. Local only.
# DATABASE_SSL=require
#
# Path to a PEM file (or the PEM itself) if the chain is not the bundled
# Supabase CA. This is the correct fix for a verification failure - not
# `no-verify`.
# DATABASE_SSL_CA=./certs/supabase-prod-ca-2021.crt

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Bucket holding immutable business documents (certificates, PODs).
NEXT_PUBLIC_DOCUMENTS_BUCKET=skyjet-documents

# Private Library files. Server-only. Not a NEXT_PUBLIC_ value: the browser
# never talks to Storage; uploads and downloads go through Server Actions.
# LIBRARY_DOCUMENTS_BUCKET=library-documents
