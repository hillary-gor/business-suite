{
  "name": "skyjet-business-suite",
  "version": "0.1.0",
  "private": true,
  "description": "SkyJet Aircraft Spares - cloud business management platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:types": "node scripts/generate-types.mjs",
    "test:sql": "node scripts/run-db-tests.mjs",
    "db:validate": "node scripts/validate-schema.mjs",
    "db:check-queries": "node scripts/validate-queries.mjs",
    "db:seed": "node scripts/apply-sql.mjs supabase/seed.sql --exclude-local",
    "db:provision-role": "node scripts/provision-app-role.mjs",
    "db:provision-user": "node scripts/provision-user.mjs",
    "db:verify-role": "node scripts/verify-app-role.mjs",
    "db:describe-url": "node scripts/describe-database-url.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run db:check-queries && npm run test:sql"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "decimal.js": "^10.6.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
